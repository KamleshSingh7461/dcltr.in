# ==============================================================================
# dcltr.in — ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVER CONFIGURATION (server/index.js)
# ------------------------------------------------------------------------------
# Port the Express API server listens on (Render/Railway/Heroku auto-assign this)
PORT=3001
NODE_ENV=production

# The public URL where your frontend is hosted (used for CORS and payment return redirects)
# Examples: https://dcltr.in or https://your-project.vercel.app
FRONTEND_URL=https://dcltr.in

# Additional comma-separated CORS origins if frontend & subdomains are separate
CORS_ORIGIN=https://dcltr.in,https://seller.dcltr.in,https://admin.dcltr.in

# ------------------------------------------------------------------------------
# 2. EASEBUZZ PAYMENT GATEWAY CREDENTIALS
# ------------------------------------------------------------------------------
# Gateway Mode: 'test' for Sandbox or 'prod' for Live transactions
EASEBUZZ_ENV=test

# Your Merchant Key from Easebuzz Dashboard (Settings -> API Keys)
EASEBUZZ_KEY=your_merchant_key_here

# Your Merchant Salt from Easebuzz Dashboard (Settings -> API Keys)
EASEBUZZ_SALT=your_merchant_salt_here

# (Optional) Sub-merchant identifier for Easebuzz Wire / Payouts
EASEBUZZ_SUB_MERCHANT=

# ------------------------------------------------------------------------------
# 3. FRONTEND / VITE CONFIGURATION (src/services/api.js)
# ------------------------------------------------------------------------------
# When frontend is deployed to Vercel/Netlify and backend is on Render/Railway:
# Set this to your live backend URL (e.g. https://api.dcltr.in/api).
# If both frontend and backend are hosted on the same domain or behind a reverse proxy,
# leave empty or set to /api
VITE_API_BASE_URL=https://api.dcltr.in/api

# ------------------------------------------------------------------------------
# 4. DATABASE & STORAGE (Optional / Production DB)
# ------------------------------------------------------------------------------
# If connecting a MongoDB Atlas database or PostgreSQL database in production:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/dcltr?retryWrites=true&w=majority
# DATABASE_URL=postgresql://user:password@host:5432/dcltr
